# ---------------------------------------------------------------------------
# Copy to .env and edit. Nothing else needs configuring before `docker compose up`.
# ---------------------------------------------------------------------------

# Compose project name. Also becomes the Docker network name: <name>-net
COMPOSE_PROJECT_NAME=mctl

# Which optional services to start. Leave as "tunnel" for a real deployment.
# Set to empty to run without Cloudflare Tunnel (local testing, or if you
# terminate TLS some other way).
COMPOSE_PROFILES=tunnel

# Base domain. Each server gets <slug>.<DOMAIN> as its Minecraft hostname,
# e.g. survival.mc.example.com
# Safe to change later: on the next start the manager rehosts existing servers
# onto the new domain and updates mc-router. Worlds and containers are untouched.
DOMAIN=mc.example.com

# Public Minecraft port on the host, shared by every server routed by hostname.
MC_PORT=25565

# Address players use for servers published on their own port. Left empty,
# mctl auto-detects the host's public IP rather than using DOMAIN, which is
# usually Cloudflare-proxied and not reachable on an arbitrary game port. Set
# this to override that detection with a bare IP or a different hostname.
# Only affects what the UI shows people to connect to.
PUBLIC_HOST=

# Cloudflare Tunnel token for the manager UI (Zero Trust -> Networks -> Tunnels).
# Point the tunnel's public hostname at http://manager:8080
TUNNEL_TOKEN=

# cloudflared defaults to QUIC (UDP) with an http2 fallback that doesn't
# always kick in - many VMs and hypervisors block outbound UDP entirely,
# which shows up as an endless "failed to dial to edge with quic" retry loop
# in `docker compose logs cloudflared`. Set to http2 if you see that.
TUNNEL_TRANSPORT_PROTOCOL=

# --- Access control ---------------------------------------------------------
# The app has no login of its own. Cloudflare Access authenticates upstream and
# injects Cf-Access-Authenticated-User-Email, which the backend trusts.
# Keep this true in production, and never expose port 8080 to the internet.
REQUIRE_CF_ACCESS=true
# Optional extra allowlist (comma separated). Empty = any Access-authenticated user.
ALLOWED_EMAILS=

# For local development only: bypasses the header check with this identity.
# Leave EMPTY in production.
DEV_USER=

# --- Defaults ---------------------------------------------------------------
TZ=Europe/Zurich
MC_IMAGE=itzg/minecraft-server:latest
HELPER_IMAGE=alpine:3.20
DEFAULT_MEMORY=2G

# Optional: CurseForge API key to enable CurseForge mod installs
CF_API_KEY=
